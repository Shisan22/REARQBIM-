# ============================================================
# REARQ BIM — .gitignore
# Stack: .NET 8 (C#) + Vue 3 (Vite) + PostgreSQL + Docker
# ============================================================

# ──────────────────────────────────────────────────────────────
# .NET / C# — Build artifacts
# ──────────────────────────────────────────────────────────────
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/*.userosscache
backend/**/*.sln.docstates

# NuGet
backend/**/packages/
*.nupkg
*.snupkg
project.lock.json

# ──────────────────────────────────────────────────────────────
# Node.js / Vue / Vite — Frontend
# ──────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────────────────────────
# Environment & Secrets
# ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json

# ──────────────────────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────────────────────
docker-compose.override.yml
postgres_data/

# ──────────────────────────────────────────────────────────────
# IDEs & Editors
# ──────────────────────────────────────────────────────────────
# Visual Studio
.vs/
*.rsuser
*.sln.ide/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (Rider / WebStorm)
.idea/
*.iml

# ──────────────────────────────────────────────────────────────
# OS Generated Files
# ──────────────────────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ──────────────────────────────────────────────────────────────
# Miscellaneous
# ──────────────────────────────────────────────────────────────
*.log
*.tmp
*.temp
*.swp
*.bak
*.cache

# Gemini / AI generated temp files
gemini-code-*.html
.agents/
.gemini/
